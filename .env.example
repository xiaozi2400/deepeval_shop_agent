# 复制为 .env 并填入真实值。.env 已被 gitignore，不会进版本库。

# OpenAI 兼容接口的密钥
OPENAI_API_KEY=your_api_key_here

# OpenAI 兼容接口的地址。用原生 OpenAI 时留空或填 https://api.openai.com/v1
OPENAI_BASE_URL=https://api.example.com/v1

# Agent 与 DeepEval 使用的模型。DeepEval 可用 DEEPEVAL_MODEL 单独覆盖。
MODEL_NAME=your_model_name

# SQLite 数据库路径。相对路径锚定到项目，sqlite:///orders.db 即 data/orders.db。
# 删掉这行则用同样的默认值。数据库由 init_db() 建表并写入种子数据，不进版本库。
DATABASE_URL=sqlite:///orders.db
